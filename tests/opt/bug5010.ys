read_verilog << EOF
module Mem #(
    parameter WIDTH = 32,
    parameter SIZE = 16,
    parameter IDX_SIZE = 16
) (
    (* keep *)input wire [WIDTH-1:0] addr0,
    (* keep *)input wire [WIDTH-1:0] write_data,
    (* keep *)input wire write_en,

    (* keep *)input wire clk,

    (* keep *)output reg [WIDTH-1:0] read_data,

);
  (* keep *)reg [WIDTH-1:0] mem[SIZE-1:0];

  always @(posedge clk) begin
    if (write_en)
      mem[addr0[IDX_SIZE-1:0]] <= write_data;

    read_data <= mem[addr0[IDX_SIZE-1:0]];
  end

endmodule

module test_keep_at_instance ();

(* keep *)
Mem mem (
    .clk(),
    .write_en(),
    .write_data(),
    .read_data(),
    .addr0()
);

endmodule

EOF

hierarchy -auto-top;
select -assert-any a:keep
flatten
select -list a:keep
proc; opt -full;
stat
